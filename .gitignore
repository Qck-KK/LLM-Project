# 1. 忽略缓存与海量数据
cache/
runs/
# Generated data (prepare_data.py) is ignored; the two inputs that cannot be
# regenerated identically are kept. Git cannot re-include files inside an
# ignored directory, so ignore the contents rather than data/ itself.
data/*
!data/dummy_train.jsonl
!data/gsm8k_qwen0.5b_bon16.jsonl

# 2. 忽略模型权重文件
checkpoints/
*.pt
*.pth
*.bin

# 3. 忽略系统与 IDE 生成的临时文件
__pycache__/
*.pyc
.vscode/
.idea/
.DS_Store

# 4. 忽略本地环境变量
.env
# 5. 运行日志
*.log
